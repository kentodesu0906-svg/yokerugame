```html
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,
initial-scale=1,
maximum-scale=1,
user-scalable=no">

<title>🌍 ブロック冒険ワールド</title>

<style>

*{
    box-sizing:border-box;
    touch-action:none;
}

body{
    margin:0;
    overflow:hidden;
    background:#87ceeb;
    font-family:sans-serif;
}

canvas{
    display:block;
    width:100vw;
    height:100vh;
}

#status{
    position:fixed;
    top:8px;
    left:8px;
    z-index:20;

    color:white;
    background:rgba(0,0,0,.65);

    padding:9px;
    border-radius:12px;

    font-size:13px;
    line-height:1.45;
}

#message{
    position:fixed;
    top:8px;
    left:50%;

    transform:translateX(-50%);

    z-index:30;

    color:white;
    background:rgba(0,0,0,.65);

    padding:8px 15px;

    border-radius:15px;

    font-weight:bold;

    text-align:center;
}

#buttons{
    position:fixed;
    right:10px;
    bottom:10px;

    z-index:30;

    display:flex;
    flex-direction:column;

    gap:5px;
}

button{
    border:0;
    border-radius:12px;

    padding:9px 12px;

    font-size:15px;
    font-weight:bold;
}

#breakBtn{
    background:#9b612f;
    color:white;
}

#placeBtn{
    background:#55a943;
    color:white;
}

#attackBtn{
    background:#e44747;
    color:white;
}

#eatBtn{
    background:#e89d29;
    color:white;
}

#invBtn{
    background:#754ec4;
    color:white;
}

#craftBtn{
    background:#c39b28;
}

#saveBtn{
    background:#408dd8;
    color:white;
}

#pad{
    position:fixed;
    bottom:10px;
    left:10px;

    z-index:30;

    display:grid;

    grid-template-columns:
    55px 55px 55px;

    grid-template-rows:
    50px 50px;

    gap:3px;
}

.move{
    background:#405b78;
    color:white;
    font-size:22px;
}

#up{
    grid-column:2;
}

#left{
    grid-column:1;
    grid-row:2;
}

#down{
    grid-column:2;
    grid-row:2;
}

#right{
    grid-column:3;
    grid-row:2;
}

.panel{
    display:none;

    position:fixed;

    left:50%;
    top:50%;

    transform:
    translate(-50%,-50%);

    width:min(92vw,520px);
    max-height:85vh;

    overflow:auto;

    background:
    rgba(25,25,25,.97);

    color:white;

    padding:16px;

    border-radius:18px;

    z-index:100;

    text-align:center;
}

.item{
    display:inline-block;

    width:105px;

    margin:4px;

    padding:10px;

    background:#3d4758;

    border-radius:10px;
}

.recipe{
    display:block;

    width:100%;

    margin:6px 0;

    background:#555;

    color:white;
}

.close{
    margin-top:10px;
    background:white;
    color:black;
}

@media(max-width:600px){

    #status{
        font-size:11px;
        padding:6px;
    }

    #message{
        font-size:12px;
        max-width:45vw;
    }

    button{
        font-size:13px;
        padding:8px;
    }
}

</style>
</head>

<body>

<canvas id="game"
width="1000"
height="700">
</canvas>


<div id="status">

❤️ HP:
<span id="hp">20</span>/20

<br>

⭐ Lv:
<span id="level">1</span>

<br>

✨ EXP:
<span id="exp">0</span>/100

<br>

🪵 木:
<span id="wood">0</span>

<br>

🪨 石:
<span id="stone">0</span>

<br>

🔩 鉄:
<span id="iron">0</span>

<br>

💎 ダイヤ:
<span id="diamond">0</span>

<br>

🍎 食料:
<span id="food">5</span>

<br>

⚔️ 攻撃:
<span id="power">1</span>

<br>

<span id="clock">🌞 昼</span>

</div>


<div id="message">
🌍 ブロック冒険ワールド！
</div>


<div id="buttons">

<button id="breakBtn">
⛏️ 壊す
</button>

<button id="placeBtn">
🧱 置く
</button>

<button id="attackBtn">
⚔️ 攻撃
</button>

<button id="eatBtn">
🍎 食べる
</button>

<button id="invBtn">
🎒 バッグ
</button>

<button id="craftBtn">
🛠️ クラフト
</button>

<button id="saveBtn">
💾 保存
</button>

</div>


<div id="pad">

<button class="move"
id="up">
⬆️
</button>

<button class="move"
id="left">
⬅️
</button>

<button class="move"
id="down">
⬇️
</button>

<button class="move"
id="right">
➡️
</button>

</div>


<!-- インベントリ -->

<div class="panel"
id="inventory">

<h2>🎒 インベントリ</h2>

<div class="item">
🪵 木<br>
<span id="iWood">0</span>
</div>

<div class="item">
🪨 石<br>
<span id="iStone">0</span>
</div>

<div class="item">
🔩 鉄<br>
<span id="iIron">0</span>
</div>

<div class="item">
💎 ダイヤ<br>
<span id="iDiamond">0</span>
</div>

<div class="item">
🍎 食料<br>
<span id="iFood">0</span>
</div>

<br>

<button class="close"
onclick="closeInventory()">
閉じる
</button>

</div>


<!-- クラフト -->

<div class="panel"
id="craftMenu">

<h2>🛠️ クラフト</h2>

<button class="recipe"
onclick="craftStonePickaxe()">

⛏️ 石のツルハシ

<br>

🪵 木 ×2 + 🪨 石 ×3

</button>


<button class="recipe"
onclick="craftIronSword()">

⚔️ 鉄の剣

<br>

🪵 木 ×1 + 🔩 鉄 ×3

</button>


<button class="recipe"
onclick="craftDiamondSword()">

💎⚔️ ダイヤの剣

<br>

🪵 木 ×1 + 💎 ダイヤ ×3

</button>


<button class="recipe"
onclick="craftHouse()">

🏠 家を作る

<br>

🪵 木 ×10 + 🪨 石 ×10

</button>


<button class="close"
onclick="closeCraft()">

閉じる

</button>

</div>


<script>

/* =========================================
   基本設定
========================================= */

const canvas =
document.getElementById("game");

const ctx =
canvas.getContext("2d");


const TILE = 40;

const W = 120;

const H = 80;


/* =========================================
   ブロック

   0 空気
   1 草
   2 土
   3 石
   4 木
   5 葉
   6 鉄
   7 ダイヤ
   8 水
   9 家
   10 村人
========================================= */

let world=[];


/* =========================================
   世界生成
========================================= */

function generateWorld(){

    world=[];


    for(
        let y=0;
        y<H;
        y++
    ){

        world[y]=[];


        for(
            let x=0;
            x<W;
            x++
        ){

            if(y<20){

                world[y][x]=0;

            }else if(y===20){

                world[y][x]=1;

            }else if(y<25){

                world[y][x]=2;

            }else{

                world[y][x]=3;
            }
        }
    }


    /* 水 */

    for(let i=0;i<12;i++){

        const x=
        Math.floor(
            Math.random()*(W-10)
        );

        for(let xx=x;xx<x+5;xx++){

            if(xx>=0 && xx<W){

                world[20][xx]=8;
            }
        }
    }


    /* 木 */

    for(let i=0;i<130;i++){

        const x=
        3+
        Math.floor(
            Math.random()*(W-6)
        );


        world[19][x]=4;
        world[18][x]=4;
        world[17][x]=4;

        world[16][x]=5;
        world[16][x-1]=5;
        world[16][x+1]=5;

        world[15][x]=5;
    }


    /* 鉄 */

    for(let i=0;i<250;i++){

        const x=
        Math.floor(
            Math.random()*W
        );

        const y=
        27+
        Math.floor(
            Math.random()*35
        );

        world[y][x]=6;
    }


    /* ダイヤ */

    for(let i=0;i<80;i++){

        const x=
        Math.floor(
            Math.random()*W
        );

        const y=
        45+
        Math.floor(
            Math.random()*30
        );

        world[y][x]=7;
    }


    /* 洞窟 */

    for(let i=0;i<35;i++){

        const cx=
        5+
        Math.floor(
            Math.random()*(W-10)
        );

        const cy=
        30+
        Math.floor(
            Math.random()*35
        );


        for(
            let yy=cy-2;
            yy<=cy+2;
            yy++
        ){

            for(
                let xx=cx-3;
                xx<=cx+3;
                xx++
            ){

                if(
                    xx>=0 &&
                    xx<W &&
                    yy>=0 &&
                    yy<H
                ){

                    if(
                        Math.random()<.65
                    ){

                        world[yy][xx]=0;
                    }
                }
            }
        }
    }


    /* 村 */

    createVillage(
        Math.floor(W*.72),
        19
    );
}


/* =========================================
   村
========================================= */

let villagers=[];


function createVillage(
    cx,
    cy
){

    villagers=[];


    for(let i=0;i<5;i++){

        const x=
        cx+i*2-4;


        const y=cy;


        world[y][x]=10;


        villagers.push({

            x:x,

            y:y,

            name:"村人"
        });
    }


    /* 家 */

    for(let h=0;h<3;h++){

        const hx=
        cx+
        h*5;


        for(let y=16;y<=19;y++){

            for(
                let x=hx;
                x<hx+4;
                x++
            ){

                if(
                    y===16 ||
                    x===hx ||
                    x===hx+3 ||
                    y===19
                ){

                    world[y][x]=9;
                }
            }
        }
    }
}


/* =========================================
   初期世界
========================================= */

generateWorld();


/* =========================================
   プレイヤー
========================================= */

let player={

    x:10,

    y:17,

    hp:20,

    maxHp:20,

    level:1,

    exp:0,

    power:1
};


/* =========================================
   アイテム
========================================= */

let wood=0;

let stone=0;

let iron=0;

let diamond=0;

let food=5;


/* =========================================
   カメラ
========================================= */

let cameraX=0;

let cameraY=0;


/* =========================================
   時間
========================================= */

let time=0;


/* =========================================
   モード
========================================= */

let mode="break";


/* =========================================
   敵
========================================= */

let enemies=[];


/* =========================================
   動物
========================================= */

let animals=[];


/* =========================================
   動物生成
========================================= */

for(let i=0;i<20;i++){

    animals.push({

        x:
        5+
        Math.random()*(W-10),

        y:18,

        type:"cow",

        move:0
    });
}


/* =========================================
   キー
========================================= */

let keys={};


document.addEventListener(
"keydown",
e=>{

    keys[
        e.key.toLowerCase()
    ]=true;


    if(e.key==="e"){

        openInventory();
    }


    if(e.key===" "){

        attack();
    }
});


document.addEventListener(
"keyup",
e=>{

    keys[
        e.key.toLowerCase()
    ]=false;
});


/* =========================================
   スマホボタン
========================================= */

function hold(
    id,
    key
){

    const b=
    document.getElementById(id);


    b.addEventListener(
        "pointerdown",
        e=>{

            e.preventDefault();

            keys[key]=true;
        }
    );


    b.addEventListener(
        "pointerup",
        e=>{

            e.preventDefault();

            keys[key]=false;
        }
    );


    b.addEventListener(
        "pointercancel",
        ()=>{

            keys[key]=false;
        }
    );
}


hold("up","arrowup");

hold("down","arrowdown");

hold("left","arrowleft");

hold("right","arrowright");


/* =========================================
   プレイヤー移動
========================================= */

function movePlayer(){

    if(player.hp<=0)return;


    let dx=0;

    let dy=0;


    if(
        keys["a"]||
        keys["arrowleft"]
    ){

        dx=-.12;
    }


    if(
        keys["d"]||
        keys["arrowright"]
    ){

        dx=.12;
    }


    if(
        keys["w"]||
        keys["arrowup"]
    ){

        dy=-.12;
    }


    if(
        keys["s"]||
        keys["arrowdown"]
    ){

        dy=.12;
    }


    const nx=
    player.x+dx;

    const ny=
    player.y+dy;


    if(
        !solidAt(nx,player.y)
    ){

        player.x=nx;
    }


    if(
        !solidAt(player.x,ny)
    ){

        player.y=ny;
    }


    player.x=
    Math.max(
        1,
        Math.min(
            W-2,
            player.x
        )
    );


    player.y=
    Math.max(
        1,
        Math.min(
            H-2,
            player.y
        )
    );


    cameraX=
    player.x*TILE-
    canvas.width/2;


    cameraY=
    player.y*TILE-
    canvas.height/2;


    cameraX=
    Math.max(
        0,
        Math.min(
            W*TILE-
            canvas.width,
            cameraX
        )
    );


    cameraY=
    Math.max(
        0,
        Math.min(
            H*TILE-
            canvas.height,
            cameraY
        )
    );
}


/* =========================================
   壁判定
========================================= */

function solidAt(
    x,
    y
){

    const tx=
    Math.floor(x);

    const ty=
    Math.floor(y);


    if(
        tx<0 ||
        tx>=W ||
        ty<0 ||
        ty>=H
    ){

        return true;
    }


    const b=
    world[ty][tx];


    return (
        b===1 ||
        b===2 ||
        b===3 ||
        b===4 ||
        b===6 ||
        b===7 ||
        b===9
    );
}


/* =========================================
   ブロック描画
========================================= */

function drawBlock(
    type,
    x,
    y
){

    if(type===0)return;


    if(type===1){

        ctx.fillStyle="#55ad35";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#7bd64e";

        ctx.fillRect(
            x,y,TILE,7
        );
    }


    if(type===2){

        ctx.fillStyle="#9b6337";

        ctx.fillRect(
            x,y,TILE,TILE
        );
    }


    if(type===3){

        ctx.fillStyle="#707070";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#999";

        ctx.fillRect(
            x+7,y+8,7,7
        );

        ctx.fillRect(
            x+26,y+24,7,7
        );
    }


    if(type===4){

        ctx.fillStyle="#75451f";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#a0642b";

        ctx.fillRect(
            x+8,y,5,TILE
        );
    }


    if(type===5){

        ctx.fillStyle="#2f9e43";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#52ca5e";

        ctx.fillRect(
            x+6,y+7,11,11
        );
    }


    if(type===6){

        ctx.fillStyle="#696969";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#d88b45";

        ctx.fillRect(
            x+7,y+8,9,9
        );
    }


    if(type===7){

        ctx.fillStyle="#505050";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#38e4ed";

        ctx.fillRect(
            x+7,y+8,9,9
        );

        ctx.fillRect(
            x+25,y+23,8,8
        );
    }


    if(type===8){

        ctx.fillStyle="#258edb";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#61b9ee";

        ctx.fillRect(
            x,y+7,TILE,5
        );
    }


    if(type===9){

        ctx.fillStyle="#b36c35";

        ctx.fillRect(
            x,y,TILE,TILE
        );

        ctx.fillStyle="#7d431f";

        ctx.fillRect(
            x+12,y+10,16,30
        );
    }


    if(type===10){

        drawVillager(
            x/TILE,
            y/TILE
        );
    }


    ctx.strokeStyle=
    "rgba(0,0,0,.15)";

    ctx.strokeRect(
        x,y,TILE,TILE
    );
}


/* =========================================
   プレイヤー
========================================= */

function drawPlayer(){

    const x=
    player.x*TILE-
    cameraX;

    const y=
    player.y*TILE-
    cameraY;


    ctx.fillStyle="#2876dc";

    ctx.fillRect(
        x+7,
        y+5,
        26,
        32
    );


    ctx.fillStyle="#ffd1a0";

    ctx.fillRect(
        x+9,
        y-10,
        22,
        22
    );


    ctx.fillStyle="#57371f";

    ctx.fillRect(
        x+8,
        y-12,
        24,
        8
    );


    if(
        player.power>=3
    ){

        ctx.fillStyle="#ddd";

        ctx.fillRect(
            x+34,
            y+8,
            18,
            4
        );
    }
}


/* =========================================
   村人
========================================= */

function drawVillager(
    x,
    y
){

    const sx=
    x*TILE-cameraX;

    const sy=
    y*TILE-cameraY;


    ctx.fillStyle="#7b55b8";

    ctx.fillRect(
        sx+7,
        sy+5,
        26,
        32
    );


    ctx.fillStyle="#e0ad7a";

    ctx.fillRect(
        sx+9,
        sy-8,
        22,
        20
    );


    ctx.fillStyle="#222";

    ctx.fillRect(
        sx+13,
        sy-1,
        4,
        4
    );

    ctx.fillRect(
        sx+24,
        sy-1,
        4,
        4
    );
}


/* =========================================
   動物
========================================= */

function drawAnimals(){

    for(
        const a of animals
    ){

        const x=
        a.x*TILE-cameraX;

        const y=
        a.y*TILE-cameraY;


        ctx.fillStyle="#eee";

        ctx.fillRect(
            x+5,
            y+10,
            30,
            22
        );


        ctx.fillStyle="#333";

        ctx.fillRect(
            x+10,
            y+15,
            7,
            7
        );

        ctx.fillRect(
            x+24,
            y+19,
            6,
            6
        );
    }
}


/* =========================================
   敵
========================================= */

function drawEnemies(){

    for(
        const e of enemies
    ){

        const x=
        e.x*TILE-cameraX;

        const y=
        e.y*TILE-cameraY;


        ctx.fillStyle=
        e.boss
        ?"purple"
        :"#36aa48";


        ctx.fillRect(
            x+4,
            y+4,
            e.boss?34:31,
            e.boss?35:31
        );


        ctx.fillStyle="black";

        ctx.fillRect(
            x+10,
            y+12,
            5,
            5
        );

        ctx.fillRect(
            x+25,
            y+12,
            5,
            5
        );


        if(e.boss){

            ctx.fillStyle="gold";

            ctx.fillRect(
                x+10,
                y-8,
                22,
                8
            );
        }
    }
}


/* =========================================
   敵生成
========================================= */

function spawnEnemy(){

    const boss=
    Math.random()<.08;


    enemies.push({

        x:
        player.x+
        (Math.random()<.5?-10:10),

        y:
        20,

        hp:
        boss?30:6,

        maxHp:
        boss?30:6,

        speed:
        boss?.015:.025,

        boss:boss
    });


    message.textContent=
    boss
    ?"👑 ボスが現れた！！"
    :"👾 モンスターが現れた！";
}


/* =========================================
   敵AI
========================================= */

function updateEnemies(){

    for(
        let i=enemies.length-1;
        i>=0;
        i--
    ){

        const e=
        enemies[i];


        const dx=
        player.x-e.x;

        const dy=
        player.y-e.y;

        const d=
        Math.hypot(dx,dy);


        if(d<20 && d>.5){

            e.x+=
            dx/d*e.speed;

            e.y+=
            dy/d*e.speed;
        }


        if(d<.8){

            player.hp-=
            e.boss
            ?.035
            :.015;


            if(
                player.hp<=0
            ){

                player.hp=0;

                message.textContent=
                "💀 ゲームオーバー！";
            }
        }
    }
}


/* =========================================
   攻撃
========================================= */

function attack(){

    if(player.hp<=0)return;


    let hit=false;


    for(
        let i=enemies.length-1;
        i>=0;
        i--
    ){

        const e=
        enemies[i];


        const d=
        Math.hypot(
            e.x-player.x,
            e.y-player.y
        );


        if(d<2.5){

            e.hp-=player.power;

            hit=true;


            if(e.hp<=0){

                const reward=
                e.boss
                ?100
                :20;


                gainExp(reward);


                food+=
                e.boss
                ?5
                :1;


                enemies.splice(i,1);


                message.textContent=
                e.boss
                ?"👑 ボスを倒した！！"
                :"👾 モンスターを倒した！";
            }else{

                message.textContent=
                "⚔️ ダメージ！";
            }
        }
    }


    if(!hit){

        message.textContent=
        "⚔️ 攻撃！";
    }
}


/* =========================================
   経験値
========================================= */

function gainExp(
    amount
){

    player.exp+=amount;


    while(
        player.exp>=100
    ){

        player.exp-=100;

        player.level++;

        player.maxHp+=2;

        player.hp=
        player.maxHp;


        message.textContent=
        "⭐ レベルアップ！！";
    }
}


/* =========================================
   食べる
========================================= */

function eatFood(){

    if(food<=0){

        message.textContent=
        "🍎 食料がない！";

        return;
    }


    if(
        player.hp>=player.maxHp
    ){

        message.textContent=
        "❤️ HPは満タン！";

        return;
    }


    food--;

    player.hp=
    Math.min(
        player.maxHp,
        player.hp+5
    );


    message.textContent=
    "🍎 食べて回復した！";

    updateUI();
}


document.getElementById(
"eatBtn"
).onclick=eatFood;


/* =========================================
   タップからブロック座標
========================================= */

function getTile(e){

    const rect=
    canvas.getBoundingClientRect();


    const sx=
    canvas.width/
    rect.width;


    const sy=
    canvas.height/
    rect.height;


    const x=
    (e.clientX-
    rect.left)*
    sx+
    cameraX;


    const y=
    (e.clientY-
    rect.top)*
    sy+
    cameraY;


    return{

        x:Math.floor(x/TILE),

        y:Math.floor(y/TILE)
    };
}


/* =========================================
   壊す
========================================= */

function breakBlock(e){

    const p=
    getTile(e);


    if(
        p.x<0||
        p.x>=W||
        p.y<0||
        p.y>=H
    )return;


    const d=
    Math.hypot(
        p.x-player.x,
        p.y-player.y
    );


    if(d>4){

        message.textContent=
        "❌ もっと近づいて！";

        return;
    }


    const b=
    world[p.y][p.x];


    if(b===0)return;


    if(b===1){

        food++;

        gainExp(2);
    }


    if(b===2){

        stone++;

        gainExp(2);
    }


    if(b===3){

        stone++;

        gainExp(3);
    }


    if(b===4){

        wood++;

        gainExp(4);
    }


    if(b===5){

        food++;

        gainExp(1);
    }


    if(b===6){

        iron++;

        gainExp(8);
    }


    if(b===7){

        diamond++;

        gainExp(20);

        message.textContent=
        "💎💎 ダイヤ発見！！";
    }


    if(b===8){

        message.textContent=
        "🌊 水をすくった！";
    }


    if(b===9){

        message.textContent=
        "🏠 家の壁を壊した！";
    }


    if(b===10){

        message.textContent=
        "👨 村人だ！";
    }


    world[p.y][p.x]=0;


    updateUI();
}


/* =========================================
   置く
========================================= */

function placeBlock(e){

    const p=
    getTile(e);


    if(
        p.x<0||
        p.x>=W||
        p.y<0||
        p.y>=H
    )return;


    const d=
    Math.hypot(
        p.x-player.x,
        p.y-player.y
    );


    if(d>4){

        message.textContent=
        "❌ もっと近づいて！";

        return;
    }


    if(
        world[p.y][p.x]!==0
    )return;


    if(stone<=0){

        message.textContent=
        "🪨 石がない！";

        return;
    }


    world[p.y][p.x]=3;

    stone--;


    message.textContent=
    "🧱 石を置いた！";

    updateUI();
}


/* =========================================
   キャンバス操作
========================================= */

canvas.addEventListener(
"pointerdown",
e=>{

    if(mode==="break"){

        breakBlock(e);

    }else{

        placeBlock(e);
    }
});


/* =========================================
   モードボタン
========================================= */

document.getElementById(
"breakBtn"
).onclick=()=>{

    mode="break";

    message.textContent=
    "⛏️ 壊すモード";
};


document.getElementById(
"placeBtn"
).onclick=()=>{

    mode="place";

    message.textContent=
    "🧱 置くモード";
};


document.getElementById(
"attackBtn"
).onclick=attack;


/* =========================================
   インベントリ
========================================= */

function openInventory(){

    document.getElementById(
        "inventory"
    ).style.display="block";


    updateInventory();
}


function closeInventory(){

    document.getElementById(
        "inventory"
    ).style.display="none";
}


document.getElementById(
"invBtn"
).onclick=openInventory;


function updateInventory(){

    document.getElementById(
        "iWood"
    ).textContent=wood;


    document.getElementById(
        "iStone"
    ).textContent=stone;


    document.getElementById(
        "iIron"
    ).textContent=iron;


    document.getElementById(
        "iDiamond"
    ).textContent=diamond;


    document.getElementById(
        "iFood"
    ).textContent=food;
}


/* =========================================
   クラフト
========================================= */

document.getElementById(
"craftBtn"
).onclick=()=>{

    document.getElementById(
        "craftMenu"
    ).style.display="block";
};


function closeCraft(){

    document.getElementById(
        "craftMenu"
    ).style.display="none";
}


/* 石ツルハシ */

function craftStonePickaxe(){

    if(
        wood>=2 &&
        stone>=3
    ){

        wood-=2;

        stone-=3;

        player.power=
        Math.max(
            player.power,
            2
        );


        message.textContent=
        "⛏️ 石のツルハシを作った！";

    }else{

        message.textContent=
        "❌ 材料が足りない！";
    }


    updateUI();
}


/* 鉄剣 */

function craftIronSword(){

    if(
        wood>=1 &&
        iron>=3
    ){

        wood--;

        iron-=3;

        player.power=
        Math.max(
            player.power,
            5
        );


        message.textContent=
        "⚔️ 鉄の剣を作った！！";

    }else{

        message.textContent=
        "❌ 材料が足りない！";
    }


    updateUI();
}


/* ダイヤ剣 */

function craftDiamondSword(){

    if(
        wood>=1 &&
        diamond>=3
    ){

        wood--;

        diamond-=3;

        player.power=
        Math.max(
            player.power,
            12
        );


        message.textContent=
        "💎⚔️ 最強の剣を作った！！！";

    }else{

        message.textContent=
        "❌ ダイヤが足りない！";
    }


    updateUI();
}


/* 家 */

function craftHouse(){

    if(
        wood>=10 &&
        stone>=10
    ){

        wood-=10;

        stone-=10;


        const x=
        Math.floor(player.x);


        const y=
        Math.floor(player.y);


        for(
            let yy=-2;
            yy<=2;
            yy++
        ){

            for(
                let xx=-3;
                xx<=3;
                xx++
            ){

                const wx=x+xx;

                const wy=y+yy;


                if(
                    wx>=0 &&
                    wx<W &&
                    wy>=0 &&
                    wy<H
                ){

                    if(
                        Math.abs(xx)===3 ||
                        Math.abs(yy)===2
                    ){

                        world[wy][wx]=9;
                    }
                }
            }
        }


        message.textContent=
        "🏠 自分の家を作った！！";

    }else{

        message.textContent=
        "❌ 木と石が足りない！";
    }


    updateUI();
}


/* =========================================
   昼夜
========================================= */

function updateTime(){

    time++;


    if(time>12000){

        time=0;
    }


    const night=
    time>7000;


    document.getElementById(
        "clock"
    ).textContent=
    night
    ?"🌙 夜"
    :"🌞 昼";


    if(
        night &&
        Math.random()<.004 &&
        enemies.length<15
    ){

        spawnEnemy();
    }
}


/* =========================================
   動物AI
========================================= */

function updateAnimals(){

    for(
        const a of animals
    ){

        a.move++;


        if(
            a.move>120
        ){

            a.move=0;

            a.dx=
            Math.random()*.03-.015;
        }


        if(a.dx){

            a.x+=a.dx;
        }


        a.x=
        Math.max(
            2,
            Math.min(
                W-2,
                a.x
            )
        );
    }
}


/* =========================================
   セーブ
========================================= */

function saveGame(){

    const save={

        world:world,

        player:player,

        wood:wood,

        stone:stone,

        iron:iron,

        diamond:diamond,

        food:food,

        time:time
    };


    localStorage.setItem(
        "blockAdventureSave",
        JSON.stringify(save)
    );


    message.textContent=
    "💾 セーブした！";
}


document.getElementById(
"saveBtn"
).onclick=saveGame;


/* =========================================
   ロード
========================================= */

function loadGame(){

    const data=
    localStorage.getItem(
        "blockAdventureSave"
    );


    if(!data)return;


    try{

        const save=
        JSON.parse(data);


        world=save.world;

        player=save.player;

        wood=save.wood;

        stone=save.stone;

        iron=save.iron;

        diamond=save.diamond;

        food=save.food;

        time=save.time;


        message.textContent=
        "💾 セーブデータを読み込んだ！";

    }catch(error){

        console.log(
            "ロード失敗"
        );
    }
}


loadGame();


/* =========================================
   UI更新
========================================= */

function updateUI(){

    document.getElementById(
        "hp"
    ).textContent=
    Math.ceil(player.hp);


    document.getElementById(
        "level"
    ).textContent=
    player.level;


    document.getElementById(
        "exp"
    ).textContent=
    player.exp;


    document.getElementById(
        "wood"
    ).textContent=
    wood;


    document.getElementById(
        "stone"
    ).textContent=
    stone;


    document.getElementById(
        "iron"
    ).textContent=
    iron;


    document.getElementById(
        "diamond"
    ).textContent=
    diamond;


    document.getElementById(
        "food"
    ).textContent=
    food;


    document.getElementById(
        "power"
    ).textContent=
    player.power;


    updateInventory();
}


/* =========================================
   世界描画
========================================= */

function drawWorld(){

    const night=
    time>7000;


    ctx.fillStyle=
    night
    ?"#17213b"
    :"#87ceeb";


    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    /* 太陽 */

    if(!night){

        ctx.fillStyle="#ffe05a";

        ctx.beginPath();

        ctx.arc(
            80,
            80,
            30,
            0,
            Math.PI*2
        );

        ctx.fill();
    }


    /* 月 */

    if(night){

        ctx.fillStyle="#fff4b0";

        ctx.beginPath();

        ctx.arc(
            80,
            80,
            25,
            0,
            Math.PI*2
        );

        ctx.fill();
    }


    const startX=
    Math.floor(
        cameraX/TILE
    )-1;


    const endX=
    startX+
    Math.ceil(
        canvas.width/TILE
    )+2;


    const startY=
    Math.floor(
        cameraY/TILE
    )-1;


    const endY=
    startY+
    Math.ceil(
        canvas.height/TILE
    )+2;


    for(
        let y=startY;
        y<endY;
        y++
    ){

        for(
            let x=startX;
            x<endX;
            x++
        ){

            if(
                x>=0 &&
                x<W &&
                y>=0 &&
                y<H
            ){

                drawBlock(
                    world[y][x],

                    x*TILE-
                    cameraX,

                    y*TILE-
                    cameraY
                );
            }
        }
    }


    drawAnimals();

    drawEnemies();

    drawPlayer();
}


/* =========================================
   ゲームループ
========================================= */

let frame=0;


function loop(){

    if(player.hp>0){

        movePlayer();

        frame++;


        if(
            frame%10===0
        ){

            updateTime();

            updateEnemies();

            updateAnimals();

            updateUI();
        }
    }


    drawWorld();


    requestAnimationFrame(
        loop
    );
}


/* =========================================
   起動
========================================= */

updateUI();

loop();

</script>

</body>
</html>
```
